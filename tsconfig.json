{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2021",
		"moduleResolution": "node",
		"strict": true,
		"noImplicitAny": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"importHelpers": true,
		"skipLibCheck": true,
		"lib": ["DOM", "DOM.Iterable", "ES2021"],
		"types": ["jest", "node"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
